        </mxCell>
        <mxCell id="25g8H-DaqNSgns0Cxm-p-110" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;b&gt;&amp;nbsp;Tokenización del query&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="90" x="-2710" y="-1660" as="geometry" />
        </mxCell>
        <mxCell id="25g8H-DaqNSgns0Cxm-p-111" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;" value="El query debe pasar por el &lt;b&gt;mismo preprocessing utilizado durante la indexación.&lt;/b&gt;" vertex="1">
          <mxGeometry height="70" width="160" x="-2770" y="-1590" as="geometry" />
        </mxCell>
        <mxCell id="25g8H-DaqNSgns0Cxm-p-113" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;" value="&lt;b&gt;Corpus &lt;/b&gt;es el conjunto completo de todos los textos sobres los que vas a buscar. En tu proyecto, el corpus es: todos los chunks (trozos) de todos los archivos .py y .md del repositorio de vLLM, ya troceados." vertex="1">
          <mxGeometry height="90" width="210" x="-3240" y="-1600" as="geometry" />
        </mxCell>
        <mxCell id="25g8H-DaqNSgns0Cxm-p-116" edge="1" parent="1" source="25g8H-DaqNSgns0Cxm-p-114" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;curved=1;" target="25g8H-DaqNSgns0Cxm-p-113">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="25g8H-DaqNSgns0Cxm-p-114" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;" value="&lt;b&gt;Indexar &lt;/b&gt;es procesar ese corpus por adelantado para poder buscar en él rapido después, en vez de tener que releer y analizar todo cada vez que alguien pregunta algo.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Es la misma idea que el índice de un libro: en vez de leer las 400 páginas cada vez que buscas dónde se habla de &quot;mitocondrias&quot;, el libro tiene un índice al final que dice &quot;mitocondrías&quot;: página 145, 203, 310, construirlo una vez, usando muchas veces.&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="260" x="-3520" y="-1640" as="geometry" />
        </mxCell>
        <mxCell id="25g8H-DaqNSgns0Cxm-p-115" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;" value="&lt;b&gt;query &lt;/b&gt;es la pregunta o texto de búsqueda que escribe el usuario. Es simplemente la palabra en inglés para &lt;b&gt;consulta.&amp;nbsp;&lt;/b&gt;&lt;br&gt;&lt;b&gt;&lt;i&gt;&lt;br&gt;&lt;/i&gt;&lt;/b&gt;&lt;div&gt;&lt;i&gt;&lt;b&gt;rag.search(query=&lt;/b&gt;&quot;How to configure the OpenIA server?&quot;, k=5&lt;b&gt;)&lt;/b&gt;&lt;/i&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="210" x="-3420" y="-1460" as="geometry" />
        </mxCell>
        <mxCell id="25g8H-DaqNSgns0Cxm-p-117" edge="1" parent="1" source="25g8H-DaqNSgns0Cxm-p-115" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.198;entryY=1.033;entryDx=0;entryDy=0;entryPerimeter=0;curved=1;exitX=0.831;exitY=0.003;exitDx=0;exitDy=0;exitPerimeter=0;" target="25g8H-DaqNSgns0Cxm-p-113">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="25g8H-DaqNSgns0Cxm-p-119" edge="1" parent="1" source="25g8H-DaqNSgns0Cxm-p-118" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=1;entryDx=0;entryDy=0;curved=1;" target="25g8H-DaqNSgns0Cxm-p-113">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="25g8H-DaqNSgns0Cxm-p-118" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;" value="&lt;b&gt;tokenizar &lt;/b&gt;partir un texto en piezas más pequeñas(normalmente palabras) para poder trabajar con ellas por separado, en vez de tratar el texto como un bloque único. &lt;b&gt;&lt;i&gt;(nota que normalmente al tokenizar también se pasa a minúsculas y se quita la puntuación eso ya depende de cómo esté configurado el tokenizador).&lt;/i&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="130" width="240" x="-3200" y="-1460" as="geometry" />
        </mxCell>
        <mxCell id="25g8H-DaqNSgns0Cxm-p-122" edge="1" parent="1" source="25g8H-DaqNSgns0Cxm-p-120" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="25g8H-DaqNSgns0Cxm-p-113">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="25g8H-DaqNSgns0Cxm-p-120" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;" value="&lt;b&gt;stemming &lt;/b&gt;reducir la palabra a su raíz, quitando sufijos, para que variantes de una misma palabra cuenten como &quot;la misma&quot; a buscar." vertex="1">
          <mxGeometry height="70" width="200" x="-2990" y="-1590" as="geometry" />
        </mxCell>
        <mxCell id="25g8H-DaqNSgns0Cxm-p-123" parent="1" style="shape=note;size=20;whiteSpace=wrap;html=1;align=left;" value="&lt;div style=&quot;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font&gt;Ejemplo:&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;div&gt;&quot;retrieving&quot;&amp;nbsp; → &quot;retriev&quot;&lt;/div&gt;&lt;div&gt;&quot;retrieved&quot;&amp;nbsp; &amp;nbsp;→ &quot;retriev&quot;&lt;/div&gt;&lt;div&gt;&quot;retriever&quot;&amp;nbsp; &amp;nbsp;→ &quot;retriev&quot;&lt;/div&gt;&lt;div&gt;&quot;retrieval&quot;&amp;nbsp; &amp;nbsp;→ &quot;retriev&quot;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="140" x="-2960" y="-1690" as="geometry" />
        </mxCell>
        <mxCell id="25g8H-DaqNSgns0Cxm-p-125" edge="1" parent="1" source="25g8H-DaqNSgns0Cxm-p-123" style="endArrow=none;dashed=1;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.528;entryY=0.015;entryDx=0;entryDy=0;entryPerimeter=0;" target="25g8H-DaqNSgns0Cxm-p-120" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="-2891" y="-1476" as="sourcePoint" />
            <mxPoint x="-2920" y="-1490" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="25g8H-DaqNSgns0Cxm-p-126" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;" value="&lt;b&gt;Todas &lt;/b&gt;se reducen a la raíz &quot;retriev&quot;. ¿Por qué importa? Porque si el corpus tiene la palabra &lt;b&gt;&quot;retrieval&quot;&amp;nbsp;&lt;/b&gt;&amp;nbsp;y el usuario en su query escribe &quot;&lt;b&gt;retrieving&quot;, &lt;/b&gt;sin stemming &lt;b&gt;BM25&amp;nbsp;&lt;/b&gt;&amp;nbsp;las trataría como palabras &lt;b&gt;completamente distintas &lt;/b&gt;(son strings diferentes) y no encontraría la coincidencia, aunque para un humano sea obviamente la misma idea." vertex="1">
          <mxGeometry height="120" width="260" x="-2935" y="-1455" as="geometry" />
        </mxCell>
        <mxCell id="25g8H-DaqNSgns0Cxm-p-127" edge="1" parent="1" source="25g8H-DaqNSgns0Cxm-p-126" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.478;entryY=0.964;entryDx=0;entryDy=0;entryPerimeter=0;curved=1;" target="25g8H-DaqNSgns0Cxm-p-120">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aI3Ot4zGlF9XPwriC0AH-2" edge="1" parent="1" source="pQLKY-sql46gv8xA9iIH-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;curved=1;" target="pQLKY-sql46gv8xA9iIH-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pQLKY-sql46gv8xA9iIH-1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;" value="&lt;b&gt;RAG&lt;/b&gt;&amp;nbsp;es un modelo de lenguaje &lt;b&gt;se entrena una vez y luego &quot;solo sabe&quot; lo que vio en ese entrenamiento&lt;/b&gt;. Si quieres que responda sobre algo nuevo (como el código fuente de vLLM, que seguro no estaba en su entrenamiento), tienes 2 opciones: reentrenarlo (caro, lento) o darle acceso a una fuente externa de información en el momento de responder. &lt;b&gt;Eso segundo es RAG.&lt;/b&gt;" vertex="1">
          <mxGeometry height="120" width="270" x="-2432.99" y="-1674" as="geometry" />
        </mxCell>
        <mxCell id="pQLKY-sql46gv8xA9iIH-2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Indexing&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Antes de nada, organizas tus documentos (el repo de vLLM) en una estructura que se pueda buscar rápido. Aquí es donde entra el chunking: partir archivos grandes en trozos manejables.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="180" x="-2632.99" y="-1489" as="geometry" />
        </mxCell>
        <mxCell id="pQLKY-sql46gv8xA9iIH-4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Retrieving&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center;&quot;&gt;Dada una pregunta el usuario, busca en ese índice los trozos más relevantes. Aquí es donde vive &lt;b&gt;BM25/TF-IDF &lt;/b&gt;en tu proyecto.&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="170" x="-2442.99" y="-1484" as="geometry" />
        </mxCell>
        <mxCell id="pQLKY-sql46gv8xA9iIH-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Retrieving&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center;&quot;&gt;Dada una pregunta el usuario, busca en ese índice los trozos más relevantes. Aquí es donde vive &lt;b&gt;BM25/TF-IDF &lt;/b&gt;en tu proyecto.&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="170" x="-2262.99" y="-1484" as="geometry" />
        </mxCell>
        <mxCell id="aI3Ot4zGlF9XPwriC0AH-1" edge="1" parent="1" source="pQLKY-sql46gv8xA9iIH-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.527;entryY=0.001;entryDx=0;entryDy=0;entryPerimeter=0;curved=1;exitX=0.496;exitY=1.003;exitDx=0;exitDy=0;exitPerimeter=0;" target="pQLKY-sql46gv8xA9iIH-2">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-2297.99" y="-1549" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="aI3Ot4zGlF9XPwriC0AH-3" edge="1" parent="1" source="pQLKY-sql46gv8xA9iIH-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.526;entryY=-0.009;entryDx=0;entryDy=0;entryPerimeter=0;curved=1;" target="pQLKY-sql46gv8xA9iIH-5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aI3Ot4zGlF9XPwriC0AH-4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Generating&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center;&quot;&gt;El LLM lee ese contexto + la pregunta y genera una respuesta en lenguaje natural.&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="150" x="-2082.99" y="-1479" as="geometry" />
        </mxCell>
        <mxCell id="aI3Ot4zGlF9XPwriC0AH-5" edge="1" parent="1" source="pQLKY-sql46gv8xA9iIH-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.519;entryY=0.009;entryDx=0;entryDy=0;entryPerimeter=0;curved=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="aI3Ot4zGlF9XPwriC0AH-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aI3Ot4zGlF9XPwriC0AH-10" edge="1" parent="1" source="aI3Ot4zGlF9XPwriC0AH-7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;curved=1;" target="aI3Ot4zGlF9XPwriC0AH-8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aI3Ot4zGlF9XPwriC0AH-16" edge="1" parent="1" source="aI3Ot4zGlF9XPwriC0AH-7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;curved=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="aI3Ot4zGlF9XPwriC0AH-14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aI3Ot4zGlF9XPwriC0AH-7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;" value="&lt;b&gt;BM25 vs TD-IDF&lt;/b&gt;&lt;br&gt;Ambos son &lt;b&gt;algoritmos de retrievel&lt;/b&gt; (basado en palabras exactas, no en significado).&amp;nbsp;" vertex="1">
          <mxGeometry height="61" width="170" x="-1942.99" y="-1770" as="geometry" />
        </mxCell>
        <mxCell id="aI3Ot4zGlF9XPwriC0AH-12" edge="1" parent="1" source="aI3Ot4zGlF9XPwriC0AH-8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;curved=1;" target="aI3Ot4zGlF9XPwriC0AH-9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aI3Ot4zGlF9XPwriC0AH-8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;" value="&lt;b&gt;BM25&lt;/b&gt;" vertex="1">
          <mxGeometry height="20" width="40" x="-1952.99" y="-1669" as="geometry" />
        </mxCell>
        <mxCell id="aI3Ot4zGlF9XPwriC0AH-9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;" value="Es una evolución que &lt;b&gt;añade saturación de frecuencia&lt;/b&gt; (que una palabra aparezca 50 veces no es más relevante que si aparece 1 vez) y normalización por longitud de dcumento. Es más robusto en la práctica.&amp;nbsp;" vertex="1">
          <mxGeometry height="92" width="220" x="-1982.99" y="-1616" as="geometry" />
        </mxCell>
        <mxCell id="aI3Ot4zGlF9XPwriC0AH-14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;" value="&lt;b&gt;TF-IDF&lt;/b&gt;" vertex="1">
          <mxGeometry height="20" width="40" x="-1707.99" y="-1669" as="geometry" />
        </mxCell>
        <mxCell id="aI3Ot4zGlF9XPwriC0AH-15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;" value="Pondera palabras por frecuencia en el documento vs. rareza en el corpus," vertex="1">
          <mxGeometry height="50" width="150" x="-1752.99" y="-1619" as="geometry" />
        </mxCell>
        <mxCell id="aI3Ot4zGlF9XPwriC0AH-17" edge="1" parent="1" source="aI3Ot4zGlF9XPwriC0AH-14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.436;entryY=0.023;entryDx=0;entryDy=0;entryPerimeter=0;" target="aI3Ot4zGlF9XPwriC0AH-15">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aI3Ot4zGlF9XPwriC0AH-18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;" value="&lt;b&gt;Recll@k&lt;/b&gt;&lt;div&gt;&amp;nbsp;Mide, de las fuentes correctas que debería haber encontrado, qué fracción efectivamente aparece entre las &lt;b&gt;top-k &lt;/b&gt;que devolviste. &lt;b&gt;No mide precisión (cuántas de las que devolviste son relevantes), &lt;/b&gt;solo cobertura. Por eso @1, @2, @5... : cuanto más alto el k, más fácil des que acierte (da mas oportunidades), así que &lt;b&gt;recall@10 &lt;/b&gt;siempre será &amp;gt;= &lt;b&gt;recall@1.&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="270" x="-1912.99" y="-1489" as="geometry" />
        </mxCell>
        <mxCell id="aI3Ot4zGlF9XPwriC0AH-20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;" value="&lt;b&gt;El truco del overlap del 5%&lt;/b&gt;&lt;div&gt;&amp;nbsp;Como los chunks no coinciden exactamente con la ubicación &lt;b&gt;&quot;ground truth&quot; &lt;/b&gt;(depende de cómo trocees el texto), en vez de exigir coincidencia exacta de índices, se acepta que haya al menos un 5% de solapamiento entre el rango que tú devolviste y el rango correcto.&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="205" x="-1632.99" y="-1489" as="geometry" />
        </mxCell>
        <mxCell id="aI3Ot4zGlF9XPwriC0AH-21" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;" value="&lt;b&gt;Por qué Qwen3-0.6B y el truco /no_think&lt;/b&gt;&lt;br&gt;&lt;div&gt;&amp;nbsp;Es un modelo pequeño (0.6B parámetros) pensado para poder correr en CPU/GPU modesta, parte de la familia Qwen3 que tiene modo de &quot;razonamiento&quot; activable (piensa paso a paso dentro de &lt;b&gt;&amp;lt;think&amp;gt;...&amp;lt;/think&amp;gt; &lt;/b&gt;antes de responder).&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="245" x="-1912.99" y="-1329" as="geometry" />
        </mxCell>
        <mxCell id="aI3Ot4zGlF9XPwriC0AH-22" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b style=&quot;&quot;&gt;05_Ingestion&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin: 0px 0px 0px 4px;&quot;&gt;&amp;nbsp;- chunkers: dict[str, BaseChunker]&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin: 0px 0px 0px 4px;&quot;&gt;&amp;nbsp;- raw_data_path: str&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;- ensure_repo_extracted() -&amp;gt; None&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;- ingest(max_chunk_size: int) -&amp;gt; List[Tuple[&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;MinimalSoruce, str&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;]]&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="350" x="510" y="-2040" as="geometry" />
        </mxCell>
        <mxCell id="u_uYa7TjmVCTCh9tQKVq-3" edge="1" parent="1" source="QgEM6FQyED_yBWRMwXr5-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1.004;exitY=0.397;exitDx=0;exitDy=0;exitPerimeter=0;" target="aI3Ot4zGlF9XPwriC0AH-22">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="u_uYa7TjmVCTCh9tQKVq-4" connectable="0" parent="u_uYa7TjmVCTCh9tQKVq-3" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" value="consume&lt;div&gt;salida&lt;/div&gt;" vertex="1">
          <mxGeometry relative="1" x="-0.0499" y="1" as="geometry">
            <mxPoint as="offset" />
